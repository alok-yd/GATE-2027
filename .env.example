# Frontend-only variables may start with VITE_.
# Do not put model provider secrets in browser-exposed VITE_ variables.
VITE_AI_GATEWAY_URL=/api/ai

# Server-side only. Used by server/ai-gateway.mjs.
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Server-side Gemini Nano Banana model used by AI Mentor image generation.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
VITE_GEMINI_MODEL=gemini-3.6-flash
VITE_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
NEMOTRON_API_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_API_KEY=your_nemotron_api_key_here
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b

ACHIEVER_AI_GATEWAY_HOST=127.0.0.1
ACHIEVER_AI_GATEWAY_PORT=8787
ACHIEVER_AI_TIMEOUT_MS=120000
ACHIEVER_AI_MAX_PROMPT_CHARS=24000


# Optional AI Mentor web-search provider (configure at least one on the Node gateway).
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Public gateway base URL. In Render this is wired to the gateway service automatically.
# Local development defaults to /api/ai and proxies to the local Node gateway.
VITE_AI_GATEWAY_URL=

# Comma-separated allowed browser origins for the AI gateway, e.g. https://your-app.onrender.com
ACHIEVER_ALLOWED_ORIGINS=
