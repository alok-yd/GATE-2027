rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/communityRooms/$(roomId)/members/$(request.auth.uid));
    }

    // Each signed-in user can access only their own private profile and app data.
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /appData/{recordId} {
        allow read, create, update, delete: if isOwner(userId);

        match /chunks/{chunkId} {
          allow read, create, update, delete: if isOwner(userId);
        }
      }
    }

    // Public room metadata is discoverable only by authenticated ACHIEVER students.
    // Room metadata is immutable after its approved default seed is created.
    match /communityRooms/{roomId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && roomId in [
          'general-community', 'doubt-solving', 'pyq-discussion', 'mock-test-analysis',
          'c-programming', 'data-structures', 'algorithms', 'dbms',
          'operating-systems', 'computer-organization', 'computer-networks',
          'toc-compiler-design', 'discrete-mathematics', 'engineering-mathematics',
          'data-science-ai', 'gate-da'
        ]
        && request.resource.data.keys().hasAll([
          'slug', 'name', 'description', 'category', 'sortOrder',
          'visibility', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'slug', 'name', 'description', 'category', 'sortOrder',
          'visibility', 'createdBy', 'createdAt'
        ])
        && request.resource.data.slug == roomId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 64
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.category in [
          'General', 'Practice', 'Computer Science', 'Mathematics', 'Data Science & AI'
        ]
        && request.resource.data.visibility == 'public'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /members/{memberUid} {
        // Only students who joined this room can view its member directory.
        allow get, list: if isRoomMember(roomId);

        allow create: if isSignedIn()
          && memberUid == request.auth.uid
          && get(/databases/$(database)/documents/communityRooms/$(roomId)).data.visibility == 'public'
          && request.resource.data.keys().hasAll([
            'uid', 'displayName', 'photoURL', 'role', 'joinedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'photoURL', 'role', 'joinedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() <= 1024
          && request.resource.data.role == 'member'
          && request.resource.data.joinedAt == request.time;

        allow update: if isSignedIn()
          && memberUid == request.auth.uid
          && isRoomMember(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt == request.time;
        allow delete: if isSignedIn() && memberUid == request.auth.uid;

        match /messages/{messageId} {
          // Messages are private to authenticated members of this room.
          allow get, list: if isRoomMember(roomId);

          allow create: if isRoomMember(roomId)
            && request.resource.data.keys().hasAll([
              'senderUid', 'senderName', 'senderPhotoURL', 'text', 'createdAt',
              'replyToMessageId', 'replyToSenderName', 'replyToText'
            ])
            && request.resource.data.keys().hasOnly([
              'senderUid', 'senderName', 'senderPhotoURL', 'text', 'createdAt',
              'replyToMessageId', 'replyToSenderName', 'replyToText'
            ])
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.senderName is string
            && request.resource.data.senderName.size() <= 60
            && request.resource.data.senderPhotoURL is string
            && request.resource.data.senderPhotoURL.size() <= 1024
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && request.resource.data.createdAt == request.time
            && request.resource.data.replyToMessageId is string
            && request.resource.data.replyToMessageId.size() <= 128
            && request.resource.data.replyToSenderName is string
            && request.resource.data.replyToSenderName.size() <= 60
            && request.resource.data.replyToText is string
            && request.resource.data.replyToText.size() <= 240;

          allow update: if isRoomMember(roomId)
            && resource.data.senderUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && request.resource.data.editedAt == request.time;

          allow delete: if isRoomMember(roomId)
            && resource.data.senderUid == request.auth.uid;
        }
      }
    }
  }
}
