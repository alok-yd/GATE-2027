rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isApprovedDefaultRoomSeed(roomId) {
      return (
        (roomId == 'general-community'
          && request.resource.data.name == 'General Community'
          && request.resource.data.description == 'Introductions, preparation updates and general GATE conversations.'
          && request.resource.data.category == 'General'
          && request.resource.data.sortOrder == 1)
        || (roomId == 'doubt-solving'
          && request.resource.data.name == 'Doubt Solving'
          && request.resource.data.description == 'Ask questions, explain concepts and help fellow aspirants.'
          && request.resource.data.category == 'General'
          && request.resource.data.sortOrder == 2)
        || (roomId == 'pyq-discussion'
          && request.resource.data.name == 'PYQ Discussion'
          && request.resource.data.description == 'Discuss previous-year questions, approaches and tricky options.'
          && request.resource.data.category == 'Practice'
          && request.resource.data.sortOrder == 3)
        || (roomId == 'mock-test-analysis'
          && request.resource.data.name == 'Mock Test Analysis'
          && request.resource.data.description == 'Discuss mock-test mistakes, strategies and time management.'
          && request.resource.data.category == 'Practice'
          && request.resource.data.sortOrder == 4)
        || (roomId == 'c-programming'
          && request.resource.data.name == 'C Programming'
          && request.resource.data.description == 'Pointers, arrays, expressions, storage classes and output questions.'
          && request.resource.data.category == 'Computer Science'
          && request.resource.data.sortOrder == 5)
        || (roomId == 'data-structures'
          && request.resource.data.name == 'Data Structures'
          && request.resource.data.description == 'Trees, graphs, hashing, stacks, queues and complexity.'
          && request.resource.data.category == 'Computer Science'
          && request.resource.data.sortOrder == 6)
        || (roomId == 'algorithms'
          && request.resource.data.name == 'Algorithms'
          && request.resource.data.description == 'Greedy, dynamic programming, graphs, sorting and analysis.'
          && request.resource.data.category == 'Computer Science'
          && request.resource.data.sortOrder == 7)
        || (roomId == 'dbms'
          && request.resource.data.name == 'DBMS'
          && request.resource.data.description == 'SQL, normalization, transactions, indexing and relational algebra.'
          && request.resource.data.category == 'Computer Science'
          && request.resource.data.sortOrder == 8)
        || (roomId == 'operating-systems'
          && request.resource.data.name == 'Operating Systems'
          && request.resource.data.description == 'Processes, threads, scheduling, synchronization, memory and files.'
          && request.resource.data.category == 'Computer Science'
          && request.resource.data.sortOrder == 9)
        || (roomId == 'computer-organization'
          && request.resource.data.name == 'COA'
          && request.resource.data.description == 'Pipelining, cache, memory hierarchy, instructions and I/O.'
          && request.resource.data.category == 'Computer Science'
          && request.resource.data.sortOrder == 10)
        || (roomId == 'computer-networks'
          && request.resource.data.name == 'Computer Networks'
          && request.resource.data.description == 'TCP/IP, routing, congestion control, protocols and numericals.'
          && request.resource.data.category == 'Computer Science'
          && request.resource.data.sortOrder == 11)
        || (roomId == 'toc-compiler-design'
          && request.resource.data.name == 'TOC & Compiler Design'
          && request.resource.data.description == 'Automata, grammars, decidability, parsing and code generation.'
          && request.resource.data.category == 'Computer Science'
          && request.resource.data.sortOrder == 12)
        || (roomId == 'discrete-mathematics'
          && request.resource.data.name == 'Discrete Mathematics'
          && request.resource.data.description == 'Logic, sets, relations, combinatorics, graphs and recurrence.'
          && request.resource.data.category == 'Mathematics'
          && request.resource.data.sortOrder == 13)
        || (roomId == 'engineering-mathematics'
          && request.resource.data.name == 'Engineering Mathematics'
          && request.resource.data.description == 'Linear algebra, calculus, probability and numerical methods.'
          && request.resource.data.category == 'Mathematics'
          && request.resource.data.sortOrder == 14)
        || (roomId == 'data-science-ai'
          && request.resource.data.name == 'Data Science & AI'
          && request.resource.data.description == 'Probability, statistics, machine learning and artificial intelligence.'
          && request.resource.data.category == 'Data Science & AI'
          && request.resource.data.sortOrder == 15)
        || (roomId == 'gate-da'
          && request.resource.data.name == 'GATE DA'
          && request.resource.data.description == 'Dedicated discussions for Data Science and Artificial Intelligence.'
          && request.resource.data.category == 'Data Science & AI'
          && request.resource.data.sortOrder == 16)
      );
    }

    function isValidCommunityAttachment(attachment, roomId) {
      return attachment is map
        && attachment.keys().hasAll([
          'id', 'name', 'contentType', 'size', 'kind', 'storagePath'
        ])
        && attachment.keys().hasOnly([
          'id', 'name', 'contentType', 'size', 'kind', 'storagePath'
        ])
        && attachment.id is string
        && attachment.id.size() <= 64
        && attachment.name is string
        && attachment.name.size() > 0
        && attachment.name.size() <= 120
        && attachment.contentType in [
          'image/png', 'image/jpeg', 'image/webp',
          'application/pdf', 'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'text/plain', 'text/markdown', 'text/csv'
        ]
        && attachment.size is int
        && attachment.size > 0
        && attachment.size <= 10 * 1024 * 1024
        && attachment.kind in ['image', 'document']
        && attachment.storagePath is string
        && attachment.storagePath.matches(
          'communityRooms/' + roomId + '/attachments/' + request.auth.uid + '/[A-Za-z0-9_-]+'
        );
    }

    function isRoomMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/communityRooms/$(roomId)/members/$(request.auth.uid));
    }

    // Each signed-in user can access only their own private profile and app data.
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /appData/{recordId} {
        allow read, create, update, delete: if isOwner(userId);

        match /chunks/{chunkId} {
          allow read, create, update, delete: if isOwner(userId);
        }
      }
    }

    // Public room metadata is discoverable only by authenticated ACHIEVER students.
    // Room metadata is immutable after its approved default seed is created.
    match /communityRooms/{roomId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isApprovedDefaultRoomSeed(roomId)
        && request.resource.data.keys().hasAll([
          'slug', 'name', 'description', 'category', 'sortOrder',
          'visibility', 'createdBy', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'slug', 'name', 'description', 'category', 'sortOrder',
          'visibility', 'createdBy', 'createdAt'
        ])
        && request.resource.data.slug == roomId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 64
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.category in [
          'General', 'Practice', 'Computer Science', 'Mathematics', 'Data Science & AI'
        ]
        && request.resource.data.visibility == 'public'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /members/{memberUid} {
        // A student may check their own membership document before joining.
        // Only existing room members can list the member directory.
        allow get: if isSignedIn()
          && (memberUid == request.auth.uid || isRoomMember(roomId));
        allow list: if isRoomMember(roomId);

        allow create: if isSignedIn()
          && memberUid == request.auth.uid
          && get(/databases/$(database)/documents/communityRooms/$(roomId)).data.visibility == 'public'
          && request.resource.data.keys().hasAll([
            'uid', 'displayName', 'photoURL', 'role', 'joinedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'photoURL', 'role', 'joinedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() <= 1024
          && request.resource.data.role == 'member'
          && request.resource.data.joinedAt == request.time;

        allow update: if isSignedIn()
          && memberUid == request.auth.uid
          && isRoomMember(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt == request.time;
        allow delete: if isSignedIn() && memberUid == request.auth.uid;
      }

      match /messages/{messageId} {
        // Messages are stored directly under communityRooms/{roomId}/messages.
        allow get, list: if isRoomMember(roomId);

        allow create: if isRoomMember(roomId)
          && request.resource.data.keys().hasAll([
            'senderUid', 'senderName', 'senderPhotoURL', 'text', 'attachments', 'createdAt',
            'replyToMessageId', 'replyToSenderName', 'replyToText'
          ])
          && request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'senderPhotoURL', 'text', 'attachments', 'createdAt',
            'replyToMessageId', 'replyToSenderName', 'replyToText'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 60
          && request.resource.data.senderPhotoURL is string
          && request.resource.data.senderPhotoURL.size() <= 1024
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.attachments is list
          && request.resource.data.attachments.size() <= 4
          && (
            request.resource.data.attachments.size() == 0
            || isValidCommunityAttachment(request.resource.data.attachments[0], roomId)
          )
          && (
            request.resource.data.attachments.size() < 2
            || isValidCommunityAttachment(request.resource.data.attachments[1], roomId)
          )
          && (
            request.resource.data.attachments.size() < 3
            || isValidCommunityAttachment(request.resource.data.attachments[2], roomId)
          )
          && (
            request.resource.data.attachments.size() < 4
            || isValidCommunityAttachment(request.resource.data.attachments[3], roomId)
          )
          && (request.resource.data.text.size() > 0 || request.resource.data.attachments.size() > 0)
          && request.resource.data.createdAt == request.time
          && request.resource.data.replyToMessageId is string
          && request.resource.data.replyToMessageId.size() <= 128
          && request.resource.data.replyToSenderName is string
          && request.resource.data.replyToSenderName.size() <= 60
          && request.resource.data.replyToText is string
          && request.resource.data.replyToText.size() <= 240;

        allow update: if isRoomMember(roomId)
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.editedAt == request.time;

        allow delete: if isRoomMember(roomId)
          && resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
