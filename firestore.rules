rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function profileUidMatchesPath(userId) {
      return request.resource.data.uid == userId;
    }

    // Profile, metadata, and account-owned app data are isolated by Firebase UID.
    // The document UID field is validated too; a client cannot rewrite it to
    // another identity even though the document path itself is already scoped.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && profileUidMatchesPath(userId);
      allow delete: if false;

      match /appData/{recordId} {
        allow read, create, update, delete: if isOwner(userId);

        match /chunks/{chunkId} {
          allow read, create, update, delete: if isOwner(userId);
        }
      }
    }
  }
}
